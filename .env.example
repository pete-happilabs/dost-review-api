DATABASE_URL=postgresql://dost:dost@localhost:5433/dost_reviews
ANTHROPIC_API_KEY=sk-ant-...
BATCH_CADENCE_CRON=0 6 * * *
MAX_REVIEWS_PER_BATCH=10000
RATE_LIMIT_PER_RATER_PER_TARGET=5
# Reputation engine. Leave empty to run vendor/engine.py — the reviewed, vendored copy,
# and the one the Docker image pins via ENGINE_PATH=/engine. Set it only to develop
# against a checkout of dost-reputation (e.g. D:/Projects/dost-reputation); the
# resolved file is logged at first use so you can see which copy is running.
ENGINE_PATH=
# REQUIRED in every deployed environment. Empty = X-Access-Key auth is DISABLED for
# every route (reviews, reputation, batch, and the risk routes /api/v1/signals,
# /api/v1/risk/..., /api/v1/outcomes); the service warns at startup. Dev only.
GUARD_ACCESS_KEY=
MAX_REVIEW_RETRIES=3
BATCH_TIMEZONE=UTC
STALE_BATCH_AFTER_MINUTES=60
# Onboard DB for profile validation. Empty = validation skipped (safe default, so
# `cp .env.example .env` still boots). Point this at a role with SELECT on `profile`
# only — NOT Onboard's application role, which owns tables holding plaintext PII.
# e.g. postgresql://review_api_ro:<password>@<onboard-host>:5432/onboarding_db
ONBOARD_DATABASE_URL=
ONBOARD_QUERY_TIMEOUT=2.0
